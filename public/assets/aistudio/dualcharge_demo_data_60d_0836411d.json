  "disclaimer": "All records are fictional and generated solely for a product demo. They are not real health records, diagnoses, or validated predictions.",
  "energy_index_formula": {
    "sleep_duration_score": "min(sleep_hours / 8 * 100, 100)",
    "sleep_quality_score": "(sleep_quality_1_to_5 - 1) / 4 * 100",
    "self_report_score": "(self_reported_energy_1_to_5 - 1) / 4 * 100",
    "final": "0.30 * sleep_duration_score + 0.20 * sleep_quality_score + 0.50 * self_report_score",
    "interpretation": "An illustrative app energy indicator combining sleep context with self-reported energy; not a medical or emotional-state score."
  },
